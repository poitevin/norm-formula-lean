import Mathlib.Topology.Metrizable.Basic
import NormFormula.ContinuousLogic.BanachBallLimitWitness

/-!
# Closed carriers generated by the ball-sorted witness limit

For every nonnegative rational radius, the countable witness-limit map
generates a closed subtype of the corresponding ambient ball.  The canonical
limit points are dense in this subtype, which is separable and inherits
completeness from the ambient ball sort.

This file constructs only the closed carriers.  The following layer proves
that the typed Banach operations and named predicates restrict to them.
-/

namespace NormFormula.ContinuousLogic

noncomputable section

open Set TopologicalSpace
open scoped Topology

universe u w

namespace BallWitnessIndexing

variable {Symbol : Type w} {symbolRadius : Symbol → ℚ≥0}
  {M : BallStructure.{u, w} Symbol symbolRadius}

/-- The closed ambient radius-`r` carrier generated by all finite witness
stages. -/
def LimitCarrier [Encodable Symbol] (initial : BallWitnessIndexing M)
    (radius : ℚ≥0) :=
  closure (Set.range (initial.limitMap radius))

/-- A limit index as a point of its closed generated radius sort. -/
def limitPoint [Encodable Symbol] (initial : BallWitnessIndexing M)
    (radius : ℚ≥0) (index : initial.LimitIndex radius) :
    initial.LimitCarrier radius :=
  ⟨initial.limitMap radius index,
    subset_closure (Set.mem_range_self index)⟩


/-- Canonical limit points are dense in the closed carrier of each rational
radius. -/
theorem denseRange_limitPoint [Encodable Symbol]
    (initial : BallWitnessIndexing M) (radius : ℚ≥0) :
    DenseRange (initial.limitPoint radius) := by
  intro point
  rw [Metric.mem_closure_iff]
  intro ε hε
  have hpoint := point.property
  change (point : M.Ball radius) ∈
    closure (Set.range (initial.limitMap radius)) at hpoint
  rw [Metric.mem_closure_iff] at hpoint
  obtain ⟨value, ⟨index, rfl⟩, hdist⟩ := hpoint ε hε
  exact ⟨initial.limitPoint radius index, ⟨index, rfl⟩, hdist⟩

/-- Every closed generated radius sort is separable. -/
@[reducible] noncomputable def limitCarrierSeparableSpace
    [Encodable Symbol] (initial : BallWitnessIndexing M) (radius : ℚ≥0) :
    SeparableSpace (initial.LimitCarrier radius) :=
  ((Set.countable_range (initial.limitMap radius)).isSeparable.closure).separableSpace

/-- Every closed generated radius sort is complete. -/
@[reducible] noncomputable def limitCarrierCompleteSpace
    [Encodable Symbol] (initial : BallWitnessIndexing M) (radius : ℚ≥0) :
    CompleteSpace (initial.LimitCarrier radius) :=
  isClosed_closure.isComplete.completeSpace_coe

/-- The entire closed carrier in every radius is a separable set. -/
theorem limitCarrier_isSeparable [Encodable Symbol]
    (initial : BallWitnessIndexing M) (radius : ℚ≥0) :
    IsSeparable (Set.univ : Set (initial.LimitCarrier radius)) := by
  letI : SeparableSpace (initial.LimitCarrier radius) :=
    initial.limitCarrierSeparableSpace radius
  exact isSeparable_univ_iff.mpr inferInstance

end BallWitnessIndexing

end

end NormFormula.ContinuousLogic
