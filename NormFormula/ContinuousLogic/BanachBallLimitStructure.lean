import NormFormula.ContinuousLogic.BanachBallCarrierOperations

/-!
# The predicate-expanded structure on the closed ball carriers

The complete rational ball system generated by the witness limit inherits
every named predicate by restriction from the ambient structure.  Predicate
uniform continuity is preserved under subtype inclusion.  This gives the
closed `BallStructure` used by the later term- and formula-restriction
theorems.
-/

namespace NormFormula.ContinuousLogic

noncomputable section

open scoped Topology

universe u w

namespace BallWitnessIndexing

variable {Symbol : Type w} {symbolRadius : Symbol → ℚ≥0}
  {M : BallStructure.{u, w} Symbol symbolRadius}

/-- The predicate-expanded ball structure on the closed carriers generated
by the witness-stage limit. -/
def limitBallStructure [Encodable Symbol]
    (initial : BallWitnessIndexing M) :
    BallStructure Symbol symbolRadius where
  toRationalBallSystem := initial.limitRationalBallSystem
  predicate := fun symbol point ↦ M.predicate symbol point.1
  predicate_uniformContinuous := by
    intro symbol
    exact (M.predicate_uniformContinuous symbol).comp
      uniformContinuous_subtype_val

/-- Coercion from a closed carrier into its ambient rational ball. -/
def limitBallInclusion [Encodable Symbol]
    (initial : BallWitnessIndexing M) (radius : ℚ≥0) :
    (initial.limitBallStructure).Ball radius → M.Ball radius :=
  Subtype.val


end BallWitnessIndexing

end

end NormFormula.ContinuousLogic
