import Mathlib.Topology.Metrizable.Basic
import NormFormula.ContinuousLogic.MultiTheoryIP

/-!
# A separable closed core retaining an infinite IP witness

An infinite IP witness uses countably many rows and only countably many
parameters: one parameter for each pair of finite disjoint subsets of `ℕ`.
Taking the closures of those two ranges gives separable closed carriers and a
restricted continuous structure in which the same witness survives exactly.

This is the carrier-theoretic first half of the downward Löwenheim--Skolem
step.  It deliberately does not claim elementarity: approximate
Tarski--Vaught closure under a countable dense formula fragment is the next
milestone.
-/

namespace NormFormula.ContinuousLogic

noncomputable section

open Set TopologicalSpace
open scoped Topology

attribute [local instance] Structure.rowPseudoMetricSpace
  Structure.parameterPseudoMetricSpace Structure.rowNonempty
  Structure.parameterNonempty

universe u v

/-- The countable index type of finite disjoint low/high prescriptions. -/
def DisjointFiniteNatPair :=
  {pair : Finset ℕ × Finset ℕ // Disjoint pair.1 pair.2}

noncomputable instance : Countable DisjointFiniteNatPair :=
  Function.Injective.countable Subtype.val_injective

/-- Chosen countable data underlying one infinite IP witness. -/
structure InfiniteIPWitnessCore
    (M : Structure.{u, v}) (φ : Formula 1 1) (low high : ℝ) where
  rows : ℕ → M.Row
  parameter : DisjointFiniteNatPair → M.Parameter
  low_spec : ∀ prescription i, i ∈ prescription.1.1 →
    φ.binaryValue M (rows i) (parameter prescription) ≤ low
  high_spec : ∀ prescription i, i ∈ prescription.1.2 →
    high ≤ φ.binaryValue M (rows i) (parameter prescription)

/-- Choice of one parameter for every finite disjoint prescription packages
any infinite IP witness as countable core data. -/
theorem exists_infiniteIPWitnessCore
    {M : Structure.{u, v}} {φ : Formula 1 1} {low high : ℝ}
    (hIP : HasInfiniteIPWitness M φ low high) :
    Nonempty (InfiniteIPWitnessCore M φ low high) := by
  classical
  obtain ⟨rows, hrows⟩ := hIP
  have hparameter : ∀ prescription : DisjointFiniteNatPair,
      ∃ parameter : M.Parameter,
        (∀ i ∈ prescription.1.1,
          φ.binaryValue M (rows i) parameter ≤ low) ∧
        (∀ i ∈ prescription.1.2,
          high ≤ φ.binaryValue M (rows i) parameter) := by
    intro prescription
    exact hrows prescription.1.1 prescription.1.2 prescription.2
  choose parameter hparameter using hparameter
  exact ⟨{
    rows := rows
    parameter := parameter
    low_spec := fun prescription ↦ (hparameter prescription).1
    high_spec := fun prescription ↦ (hparameter prescription).2 }⟩

namespace InfiniteIPWitnessCore

variable {M : Structure.{u, v}} {φ : Formula 1 1} {low high : ℝ}

/-- Closed row carrier generated by the witness sequence. -/
def RowCarrier (core : InfiniteIPWitnessCore M φ low high) :=
  closure (Set.range core.rows)

/-- Closed parameter carrier generated by the chosen finite-pattern
parameters. -/
def ParameterCarrier (core : InfiniteIPWitnessCore M φ low high) :=
  closure (Set.range core.parameter)

/-- The original predicate restricted to the two closed countably generated
carriers. -/
def toStructure (core : InfiniteIPWitnessCore M φ low high) : Structure where
  Row := core.RowCarrier
  Parameter := core.ParameterCarrier
  rowNonempty :=
    ⟨⟨core.rows 0, subset_closure (Set.mem_range_self 0)⟩⟩
  parameterNonempty := by
    let emptyPrescription : DisjointFiniteNatPair :=
      ⟨(∅, ∅), by simp⟩
    exact ⟨⟨core.parameter emptyPrescription,
      subset_closure (Set.mem_range_self emptyPrescription)⟩⟩
  predicate := fun row parameter ↦ M.predicate row.1 parameter.1
  predicate_uniformContinuous := by
    have hrow : UniformContinuous
        (fun pair : core.RowCarrier × core.ParameterCarrier ↦
          (pair.1.1 : M.Row)) :=
      uniformContinuous_subtype_val.comp uniformContinuous_fst
    have hparameter : UniformContinuous
        (fun pair : core.RowCarrier × core.ParameterCarrier ↦
          (pair.2.1 : M.Parameter)) :=
      uniformContinuous_subtype_val.comp uniformContinuous_snd
    exact M.predicate_uniformContinuous.comp (hrow.prodMk hparameter)

/-- The countably generated row carrier is separable. -/
@[reducible] noncomputable def rowCarrierSeparableSpace
    (core : InfiniteIPWitnessCore M φ low high) :
    SeparableSpace core.RowCarrier :=
  ((Set.countable_range core.rows).isSeparable.closure).separableSpace

/-- The countably generated parameter carrier is separable. -/
@[reducible] noncomputable def parameterCarrierSeparableSpace
    (core : InfiniteIPWitnessCore M φ low high) :
    SeparableSpace core.ParameterCarrier :=
  ((Set.countable_range core.parameter).isSeparable.closure).separableSpace

/-- If the ambient row sort is complete, its closed witness core is complete. -/
@[reducible] noncomputable def rowCarrierCompleteSpace
    [CompleteSpace M.Row]
    (core : InfiniteIPWitnessCore M φ low high) :
    CompleteSpace core.RowCarrier :=
  isClosed_closure.isComplete.completeSpace_coe

/-- If the ambient parameter sort is complete, its closed witness core is
complete. -/
@[reducible] noncomputable def parameterCarrierCompleteSpace
    [CompleteSpace M.Parameter]
    (core : InfiniteIPWitnessCore M φ low high) :
    CompleteSpace core.ParameterCarrier :=
  isClosed_closure.isComplete.completeSpace_coe

/-- Both carriers of the restricted structure are separable. -/
theorem carriers_isSeparable
    (core : InfiniteIPWitnessCore M φ low high) :
    IsSeparable (Set.univ : Set core.RowCarrier) ∧
      IsSeparable (Set.univ : Set core.ParameterCarrier) := by
  letI : SeparableSpace core.RowCarrier := core.rowCarrierSeparableSpace
  letI : SeparableSpace core.ParameterCarrier :=
    core.parameterCarrierSeparableSpace
  exact ⟨isSeparable_univ_iff.mpr inferInstance,
    isSeparable_univ_iff.mpr inferInstance⟩

/-- The restricted atomic predicate retains the original infinite witness
with exactly the same thresholds. -/
theorem atomic_hasInfiniteIPWitness
    (core : InfiniteIPWitnessCore M Formula.atomic low high) :
    HasInfiniteIPWitness core.toStructure Formula.atomic low high := by
  classical
  let coreRows : ℕ → core.RowCarrier := fun n ↦
    ⟨core.rows n, subset_closure (Set.mem_range_self n)⟩
  refine ⟨coreRows, ?_⟩
  intro E F hdisjoint
  let prescription : DisjointFiniteNatPair := ⟨(E, F), hdisjoint⟩
  let coreParameter : core.ParameterCarrier :=
    ⟨core.parameter prescription,
      subset_closure (Set.mem_range_self prescription)⟩
  refine ⟨coreParameter, ?_, ?_⟩
  · intro i hi
    exact core.low_spec prescription i hi
  · intro i hi
    exact core.high_spec prescription i hi

end InfiniteIPWitnessCore

/-- Theory-level atomic IP already yields an ambient same-theory model and,
inside it, a separable closed substructure retaining the infinite witness.
The theorem intentionally does not assert that the restricted core is
elementary; this pinpoints the remaining downward-LS obligation. -/
theorem exists_separableAtomicIPCore_of_hasIPInCompleteTheory
    {M : Structure.{u, v}}
    (hIP : HasIPInCompleteTheory M Formula.atomic) :
    ∃ N : Structure.{u, v}, SameCompleteTheory M N ∧
      ∃ low high : ℝ, low < high ∧
        ∃ core : InfiniteIPWitnessCore N Formula.atomic low high,
          IsSeparable (Set.univ : Set core.RowCarrier) ∧
          IsSeparable (Set.univ : Set core.ParameterCarrier) ∧
          HasInfiniteIPWitness core.toStructure Formula.atomic low high := by
  obtain ⟨N, hTheory, low, high, hgap, hWitness⟩ := hIP
  obtain ⟨core⟩ := exists_infiniteIPWitnessCore hWitness
  exact ⟨N, hTheory, low, high, hgap, core,
    core.carriers_isSeparable.1, core.carriers_isSeparable.2,
    core.atomic_hasInfiniteIPWitness⟩

end

end NormFormula.ContinuousLogic
