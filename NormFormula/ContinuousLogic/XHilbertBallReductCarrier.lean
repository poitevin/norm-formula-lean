import Mathlib.Topology.Algebra.Module.Basic
import NormFormula.ContinuousLogic.BanachBallTarskiVaught
import NormFormula.ContinuousLogic.XHilbertBallExpansion

/-!
# The one-sorted carrier generated by the closed ball limit

The closed witness-limit sorts live as closed subsets of the standard
rational balls of `XSpace`.  Their union need not itself be closed, so the
honest one-sorted Banach carrier is the closed real linear span of all their
ambient images.  This file constructs that subspace and proves that it is
complete and separable.
-/

namespace NormFormula.X.BallLanguage

noncomputable section

open Set TopologicalSpace
open scoped Topology
open NormFormula.ContinuousLogic

/-- The ambient `XSpace` image of one closed witness-limit radius sort. -/
def limitCarrierImage
    (initial : BallWitnessIndexing expansionStructure) (radius : ℚ≥0) :
    Set XSpace :=
  Set.range fun point : initial.LimitCarrier radius ↦ point.1.1

/-- The union in `XSpace` of all rational-radius closed limit carriers. -/
def limitGeneratingSet
    (initial : BallWitnessIndexing expansionStructure) : Set XSpace :=
  ⋃ radius : ℚ≥0, limitCarrierImage initial radius

/-- The closed real linear span of all closed limit-carrier images. -/
def limitBanachSubspace
    (initial : BallWitnessIndexing expansionStructure) : Submodule ℝ XSpace :=
  (Submodule.span ℝ (limitGeneratingSet initial)).topologicalClosure

/-- The ordinary one-sorted Banach-space carrier generated by the
Tarski--Vaught ball limit. -/
abbrev LimitBanachSpace
    (initial : BallWitnessIndexing expansionStructure) :=
  limitBanachSubspace initial

/-- Every point of a closed radius sort belongs to the generating union after
forgetting its two subtype layers. -/
theorem limitCarrierValue_mem_limitGeneratingSet
    (initial : BallWitnessIndexing expansionStructure) (radius : ℚ≥0)
    (point : initial.LimitCarrier radius) :
    point.1.1 ∈ limitGeneratingSet initial := by
  exact Set.mem_iUnion.2 ⟨radius, Set.mem_range_self point⟩

/-- Every closed radius-sort point embeds canonically in the one-sorted
closed linear span. -/
def limitCarrierToBanachSpace
    (initial : BallWitnessIndexing expansionStructure) (radius : ℚ≥0) :
    initial.LimitCarrier radius → LimitBanachSpace initial :=
  fun point ↦ ⟨point.1.1,
    Submodule.le_topologicalClosure _
      (Submodule.subset_span
        (limitCarrierValue_mem_limitGeneratingSet initial radius point))⟩

@[simp]
theorem limitCarrierToBanachSpace_val
    (initial : BallWitnessIndexing expansionStructure) (radius : ℚ≥0)
    (point : initial.LimitCarrier radius) :
    (limitCarrierToBanachSpace initial radius point : XSpace) = point.1.1 :=
  rfl

/-- The ambient image of each individual closed radius sort is separable. -/
theorem limitCarrierImage_isSeparable
    (initial : BallWitnessIndexing expansionStructure) (radius : ℚ≥0) :
    IsSeparable (limitCarrierImage initial radius) := by
  have hcontinuous : Continuous
      (fun point : initial.LimitCarrier radius ↦ (point.1.1 : XSpace)) :=
    (uniformContinuous_subtype_val.comp
      uniformContinuous_subtype_val).continuous
  simpa only [limitCarrierImage, Set.image_univ] using
    (initial.limitCarrier_isSeparable radius).image hcontinuous

/-- The countable union of all closed radius-sort images is separable. -/
theorem limitGeneratingSet_isSeparable
    (initial : BallWitnessIndexing expansionStructure) :
    IsSeparable (limitGeneratingSet initial) := by
  exact IsSeparable.iUnion fun radius ↦
    limitCarrierImage_isSeparable initial radius

/-- The closed real linear span used for the reduct is a separable subset of
the ambient `XSpace`. -/
theorem limitBanachSubspace_isSeparable
    (initial : BallWitnessIndexing expansionStructure) :
    IsSeparable (limitBanachSubspace initial : Set XSpace) := by
  rw [limitBanachSubspace, Submodule.topologicalClosure_coe]
  exact (limitGeneratingSet_isSeparable initial).span.closure

/-- The generated one-sorted carrier inherits a separable topology. -/
@[reducible] noncomputable def limitBanachSpaceSeparableSpace
    (initial : BallWitnessIndexing expansionStructure) :
    SeparableSpace (LimitBanachSpace initial) :=
  (limitBanachSubspace_isSeparable initial).separableSpace

/-- The generated one-sorted carrier is complete because it is a closed
subspace of the Banach space `XSpace`. -/
@[reducible] noncomputable def limitBanachSpaceCompleteSpace
    (initial : BallWitnessIndexing expansionStructure) :
    CompleteSpace (LimitBanachSpace initial) :=
  by
    change CompleteSpace
      ((Submodule.span ℝ (limitGeneratingSet initial)).topologicalClosure)
    infer_instance

end

end NormFormula.X.BallLanguage
