import Mathlib.Topology.Metrizable.Basic
import NormFormula.ContinuousLogic.LimitWitness

/-!
# Closed separable carriers generated by the witness limit

The countable limit maps generate two ambient subsets.  Their closures are
separable, contain the canonical limit points densely, inherit completeness
from complete ambient sorts, and carry the restriction of the ambient
many-predicate structure.
-/

namespace NormFormula.ContinuousLogic

noncomputable section

open Set TopologicalSpace
open scoped Topology

attribute [local instance] MultiStructure.rowPseudoMetricSpace
  MultiStructure.parameterPseudoMetricSpace MultiStructure.rowNonempty
  MultiStructure.parameterNonempty

universe u v w

namespace WitnessIndexing

variable {Symbol : Type w} {M : MultiStructure.{u, v, w} Symbol}

/-- The closed ambient row carrier generated by all finite witness stages. -/
def LimitRowCarrier [Encodable Symbol] (initial : WitnessIndexing M) :=
  closure (Set.range initial.limitRowMap)

/-- The closed ambient parameter carrier generated by all finite witness
stages. -/
def LimitParameterCarrier [Encodable Symbol] (initial : WitnessIndexing M) :=
  closure (Set.range initial.limitParameterMap)

/-- A limit row index as a point of the closed generated carrier. -/
def limitRowPoint [Encodable Symbol] (initial : WitnessIndexing M)
    (index : initial.LimitRowIndex) : initial.LimitRowCarrier :=
  ⟨initial.limitRowMap index, subset_closure (Set.mem_range_self index)⟩

/-- A limit parameter index as a point of the closed generated carrier. -/
def limitParameterPoint [Encodable Symbol] (initial : WitnessIndexing M)
    (index : initial.LimitParameterIndex) : initial.LimitParameterCarrier :=
  ⟨initial.limitParameterMap index,
    subset_closure (Set.mem_range_self index)⟩

/-- Canonical limit row points are dense in the closed generated row
carrier. -/
theorem denseRange_limitRowPoint [Encodable Symbol]
    (initial : WitnessIndexing M) :
    DenseRange initial.limitRowPoint := by
  intro point
  rw [Metric.mem_closure_iff]
  intro ε hε
  have hpoint := point.property
  change (point : M.Row) ∈ closure (Set.range initial.limitRowMap) at hpoint
  rw [Metric.mem_closure_iff] at hpoint
  obtain ⟨value, ⟨index, rfl⟩, hdist⟩ := hpoint ε hε
  exact ⟨initial.limitRowPoint index, ⟨index, rfl⟩, hdist⟩

/-- Canonical limit parameter points are dense in the closed generated
parameter carrier. -/
theorem denseRange_limitParameterPoint [Encodable Symbol]
    (initial : WitnessIndexing M) :
    DenseRange initial.limitParameterPoint := by
  intro point
  rw [Metric.mem_closure_iff]
  intro ε hε
  have hpoint := point.property
  change (point : M.Parameter) ∈
    closure (Set.range initial.limitParameterMap) at hpoint
  rw [Metric.mem_closure_iff] at hpoint
  obtain ⟨value, ⟨index, rfl⟩, hdist⟩ := hpoint ε hε
  exact ⟨initial.limitParameterPoint index, ⟨index, rfl⟩, hdist⟩

/-- Restrict the ambient structure to the closed carriers generated by the
witness limit. -/
def limitStructure [Encodable Symbol] (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex] :
    MultiStructure Symbol where
  Row := initial.LimitRowCarrier
  Parameter := initial.LimitParameterCarrier
  rowNonempty :=
    ⟨initial.limitRowPoint ⟨0, by
      simpa only [iterate] using
        (Classical.choice (inferInstance : Nonempty initial.RowIndex))⟩⟩
  parameterNonempty :=
    ⟨initial.limitParameterPoint ⟨0, by
      simpa only [iterate] using
        (Classical.choice (inferInstance : Nonempty initial.ParameterIndex))⟩⟩
  predicate := fun symbol row parameter =>
    M.predicate symbol row.1 parameter.1
  predicate_uniformContinuous := by
    intro symbol
    have hrow : UniformContinuous
        (fun pair : initial.LimitRowCarrier × initial.LimitParameterCarrier =>
          (pair.1.1 : M.Row)) :=
      uniformContinuous_subtype_val.comp uniformContinuous_fst
    have hparameter : UniformContinuous
        (fun pair : initial.LimitRowCarrier × initial.LimitParameterCarrier =>
          (pair.2.1 : M.Parameter)) :=
      uniformContinuous_subtype_val.comp uniformContinuous_snd
    exact (M.predicate_uniformContinuous symbol).comp
      (hrow.prodMk hparameter)

/-- The closed generated row carrier is separable. -/
@[reducible] noncomputable def limitRowCarrierSeparableSpace
    [Encodable Symbol] (initial : WitnessIndexing M) :
    SeparableSpace initial.LimitRowCarrier :=
  ((Set.countable_range initial.limitRowMap).isSeparable.closure).separableSpace

/-- The closed generated parameter carrier is separable. -/
@[reducible] noncomputable def limitParameterCarrierSeparableSpace
    [Encodable Symbol] (initial : WitnessIndexing M) :
    SeparableSpace initial.LimitParameterCarrier :=
  ((Set.countable_range initial.limitParameterMap).isSeparable.closure).separableSpace

/-- The closed generated row carrier is complete when the ambient row sort
is complete. -/
@[reducible] noncomputable def limitRowCarrierCompleteSpace
    [Encodable Symbol] [CompleteSpace M.Row]
    (initial : WitnessIndexing M) :
    CompleteSpace initial.LimitRowCarrier :=
  isClosed_closure.isComplete.completeSpace_coe

/-- The closed generated parameter carrier is complete when the ambient
parameter sort is complete. -/
@[reducible] noncomputable def limitParameterCarrierCompleteSpace
    [Encodable Symbol] [CompleteSpace M.Parameter]
    (initial : WitnessIndexing M) :
    CompleteSpace initial.LimitParameterCarrier :=
  isClosed_closure.isComplete.completeSpace_coe

/-- Both closed generated carriers are separable. -/
theorem limitCarriers_isSeparable [Encodable Symbol]
    (initial : WitnessIndexing M) :
    IsSeparable (Set.univ : Set initial.LimitRowCarrier) ∧
      IsSeparable (Set.univ : Set initial.LimitParameterCarrier) := by
  letI : SeparableSpace initial.LimitRowCarrier :=
    initial.limitRowCarrierSeparableSpace
  letI : SeparableSpace initial.LimitParameterCarrier :=
    initial.limitParameterCarrierSeparableSpace
  exact ⟨isSeparable_univ_iff.mpr inferInstance,
    isSeparable_univ_iff.mpr inferInstance⟩

end WitnessIndexing

end

end NormFormula.ContinuousLogic
