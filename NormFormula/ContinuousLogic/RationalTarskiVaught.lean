import NormFormula.ContinuousLogic.FormulaContinuity

/-!
# Rational Tarski--Vaught theorem for the witness-limit closure

The closed carriers generated by the countable approximate-witness stages
preserve the value of every rational formula.  Quantifier equality is first
proved on the dense canonical limit assignments, using witnesses at every
precision, and then extended to all closed assignments by continuity.
-/

namespace NormFormula.ContinuousLogic

noncomputable section

open Function Set

attribute [local instance] MultiStructure.rowPseudoMetricSpace
  MultiStructure.parameterPseudoMetricSpace MultiStructure.rowNonempty
  MultiStructure.parameterNonempty

universe u v w

namespace WitnessIndexing

variable {Symbol : Type w} {M : MultiStructure.{u, v, w} Symbol}

def limitRowInclusion [Encodable Symbol] (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (x : (initial.limitStructure).Row) : M.Row :=
  (show initial.LimitRowCarrier from x).1

def limitParameterInclusion [Encodable Symbol] (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (y : (initial.limitStructure).Parameter) : M.Parameter :=
  (show initial.LimitParameterCarrier from y).1

@[simp]
theorem limitRowInclusion_limitRowPoint [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (index : initial.LimitRowIndex) :
    initial.limitRowInclusion (initial.limitRowPoint index) =
      initial.limitRowMap index :=
  rfl

@[simp]
theorem limitParameterInclusion_limitParameterPoint [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (index : initial.LimitParameterIndex) :
    initial.limitParameterInclusion (initial.limitParameterPoint index) =
      initial.limitParameterMap index :=
  rfl

/-- Include a finite assignment in the closed limit structure into the ambient
structure. -/
def includeLimitAssignment [Encodable Symbol] (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ} :
    MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
      MultiFormula.Assignment M rowVars parameterVars :=
  fun assignment =>
    (fun i => initial.limitRowInclusion (assignment.1 i),
      fun i => initial.limitParameterInclusion (assignment.2 i))

/-- Canonical finite assignments coming from the countable witness limit. -/
def limitAssignmentPoint [Encodable Symbol] (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ} :
    (Fin rowVars → initial.LimitRowIndex) ×
        (Fin parameterVars → initial.LimitParameterIndex) →
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars :=
  fun assignment =>
    (fun i => initial.limitRowPoint (assignment.1 i),
      fun i => initial.limitParameterPoint (assignment.2 i))

theorem denseRange_limitAssignmentPoint [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (rowVars parameterVars : ℕ) :
    DenseRange (initial.limitAssignmentPoint :
      ((Fin rowVars → initial.LimitRowIndex) ×
        (Fin parameterVars → initial.LimitParameterIndex) →
          MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars)) := by
  exact (DenseRange.piMap fun _ => initial.denseRange_limitRowPoint).prodMap
    (DenseRange.piMap fun _ => initial.denseRange_limitParameterPoint)

theorem continuous_includeLimitAssignment [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (rowVars parameterVars : ℕ) :
    Continuous (initial.includeLimitAssignment :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        MultiFormula.Assignment M rowVars parameterVars) := by
  have hrow : Continuous fun assignment :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars =>
        fun i => initial.limitRowInclusion (assignment.1 i) := by
    apply continuous_pi
    intro i
    exact continuous_subtype_val.comp
      ((continuous_apply i).comp continuous_fst)
  have hparameter : Continuous fun assignment :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars =>
        fun i => initial.limitParameterInclusion (assignment.2 i) := by
    apply continuous_pi
    intro i
    exact continuous_subtype_val.comp
      ((continuous_apply i).comp continuous_snd)
  exact hrow.prodMk hparameter

/-- A rational row supremum is preserved by the closed witness-limit
restriction once its child formula is preserved. -/
theorem realize_iSupRow_limitStructure_eq_ambient [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ}
    (formula : CountableFormula Symbol (rowVars + 1) parameterVars)
    (hformula : ∀
      (rows : Fin (rowVars + 1) → (initial.limitStructure).Row)
      (parameters : Fin parameterVars → (initial.limitStructure).Parameter),
      formula.toMultiFormula.realize (initial.limitStructure) rows parameters =
        formula.toMultiFormula.realize M
          (fun i => initial.limitRowInclusion (rows i))
          (fun i => initial.limitParameterInclusion (parameters i)))
    (rows : Fin rowVars → (initial.limitStructure).Row)
    (parameters : Fin parameterVars → (initial.limitStructure).Parameter) :
    (MultiFormula.iSupRow formula.toMultiFormula).realize
        (initial.limitStructure) rows parameters =
      (MultiFormula.iSupRow formula.toMultiFormula).realize M
        (fun i => initial.limitRowInclusion (rows i))
        (fun i => initial.limitParameterInclusion (parameters i)) := by
  let restricted :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    (MultiFormula.iSupRow formula.toMultiFormula).assignmentValue
      (initial.limitStructure)
  let ambient :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    fun assignment =>
      (MultiFormula.iSupRow formula.toMultiFormula).assignmentValue M
        (initial.includeLimitAssignment assignment)
  have hrestricted : Continuous restricted :=
    (MultiFormula.iSupRow formula.toMultiFormula).continuous_assignmentValue
      (initial.limitStructure)
  have hambient : Continuous ambient :=
    ((MultiFormula.iSupRow formula.toMultiFormula).continuous_assignmentValue M).comp
      (initial.continuous_includeLimitAssignment rowVars parameterVars)
  have hequal : restricted = ambient :=
    (initial.denseRange_limitAssignmentPoint rowVars parameterVars).equalizer
      hrestricted hambient (by
        funext indices
        apply le_antisymm
        · refine iSup_le fun x => ?_
          rw [hformula]
          have hcons :
              (fun i => initial.limitRowInclusion
                (@Fin.cons rowVars
                  (fun _ : Fin (rowVars + 1) => (initial.limitStructure).Row)
                  x (initial.limitAssignmentPoint indices).1 i)) =
                Fin.cons (initial.limitRowInclusion x)
                  (fun i => initial.limitRowMap (indices.1 i)) := by
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          rw [hcons]
          change _ ≤ ⨆ z : M.Row, formula.toMultiFormula.realize M
            (Fin.cons z _) _
          simpa [limitAssignmentPoint, includeLimitAssignment] using le_iSup
            (fun z : M.Row => formula.toMultiFormula.realize M
              (Fin.cons z
                (fun i => initial.limitRowMap (indices.1 i)))
              (fun i => initial.limitParameterMap (indices.2 i)))
            (initial.limitRowInclusion x)
        · rw [← Subtype.coe_le_coe]
          apply le_of_forall_pos_le_add
          intro ε hε
          obtain ⟨precision, hprecision⟩ := exists_nat_one_div_lt hε
          have hspec := initial.limitRowWitness_spec formula
            indices.1 indices.2 precision .supremum
          have hchild := hformula
            (Fin.cons
              (initial.limitRowPoint
                (initial.limitRowWitness formula indices.1 indices.2
                  precision .supremum))
              (fun i => initial.limitRowPoint (indices.1 i)))
            (fun i => initial.limitParameterPoint (indices.2 i))
          have hchild' :
              formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) =
                formula.toMultiFormula.realize M
                  (Fin.cons
                    (initial.limitRowMap
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitRowMap (indices.1 i)))
                  (fun i => initial.limitParameterMap (indices.2 i)) := by
            rw [hchild]
            congr 2
            · funext i
              refine Fin.cases ?_ (fun j => ?_) i <;> simp
          have hwitness_le :
              formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) ≤
                (MultiFormula.iSupRow formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) :=
            by
              change _ ≤ ⨆ x, formula.toMultiFormula.realize
                (initial.limitStructure) (Fin.cons x _) _
              exact le_iSup
                (fun x : (initial.limitStructure).Row =>
                  formula.toMultiFormula.realize (initial.limitStructure)
                    (Fin.cons x
                      (fun i => initial.limitRowPoint (indices.1 i)))
                    (fun i => initial.limitParameterPoint (indices.2 i)))
                (initial.limitRowPoint
                  (initial.limitRowWitness formula indices.1 indices.2
                    precision .supremum))
          have hwitness_le_real :=
            (Subtype.coe_le_coe.mpr hwitness_le :
              (formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) ≤
                ((MultiFormula.iSupRow formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ))
          have hprecision' : witnessError precision < ε := by
            simpa [witnessError] using hprecision
          exact (calc
            ((MultiFormula.iSupRow formula.toMultiFormula).realize M
                (fun i => initial.limitRowMap (indices.1 i))
                (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) <
                (formula.toMultiFormula.realize M
                    (Fin.cons
                      (initial.limitRowMap
                        (initial.limitRowWitness formula indices.1 indices.2
                          precision .supremum))
                      (fun i => initial.limitRowMap (indices.1 i)))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) +
                  witnessError precision := hspec
            _ = (formula.toMultiFormula.realize (initial.limitStructure)
                    (Fin.cons
                      (initial.limitRowPoint
                        (initial.limitRowWitness formula indices.1 indices.2
                          precision .supremum))
                      (fun i => initial.limitRowPoint (indices.1 i)))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) +
                  witnessError precision := by
              exact congrArg (fun value : TruthValue => (value : ℝ) +
                witnessError precision) hchild'.symm
            _ ≤ ((MultiFormula.iSupRow formula.toMultiFormula).realize
                    (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) +
                  witnessError precision := by
              simpa [add_comm] using
                add_le_add_right hwitness_le_real (witnessError precision)
            _ < ((MultiFormula.iSupRow formula.toMultiFormula).realize
                    (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) + ε :=
              by simpa [add_comm] using
                add_lt_add_left hprecision'
                  ((MultiFormula.iSupRow formula.toMultiFormula).realize
                    (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ)).le)
  exact congrFun hequal (rows, parameters)

/-- A rational row infimum is preserved by the closed witness-limit
restriction once its child formula is preserved. -/
theorem realize_iInfRow_limitStructure_eq_ambient [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ}
    (formula : CountableFormula Symbol (rowVars + 1) parameterVars)
    (hformula : ∀
      (rows : Fin (rowVars + 1) → (initial.limitStructure).Row)
      (parameters : Fin parameterVars → (initial.limitStructure).Parameter),
      formula.toMultiFormula.realize (initial.limitStructure) rows parameters =
        formula.toMultiFormula.realize M
          (fun i => initial.limitRowInclusion (rows i))
          (fun i => initial.limitParameterInclusion (parameters i)))
    (rows : Fin rowVars → (initial.limitStructure).Row)
    (parameters : Fin parameterVars → (initial.limitStructure).Parameter) :
    (MultiFormula.iInfRow formula.toMultiFormula).realize
        (initial.limitStructure) rows parameters =
      (MultiFormula.iInfRow formula.toMultiFormula).realize M
        (fun i => initial.limitRowInclusion (rows i))
        (fun i => initial.limitParameterInclusion (parameters i)) := by
  let restricted :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    (MultiFormula.iInfRow formula.toMultiFormula).assignmentValue
      (initial.limitStructure)
  let ambient :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    fun assignment =>
      (MultiFormula.iInfRow formula.toMultiFormula).assignmentValue M
        (initial.includeLimitAssignment assignment)
  have hrestricted : Continuous restricted :=
    (MultiFormula.iInfRow formula.toMultiFormula).continuous_assignmentValue
      (initial.limitStructure)
  have hambient : Continuous ambient :=
    ((MultiFormula.iInfRow formula.toMultiFormula).continuous_assignmentValue M).comp
      (initial.continuous_includeLimitAssignment rowVars parameterVars)
  have hequal : restricted = ambient :=
    (initial.denseRange_limitAssignmentPoint rowVars parameterVars).equalizer
      hrestricted hambient (by
        funext indices
        apply le_antisymm
        · rw [← Subtype.coe_le_coe]
          apply le_of_forall_pos_le_add
          intro ε hε
          obtain ⟨precision, hprecision⟩ := exists_nat_one_div_lt hε
          have hspec := initial.limitRowWitness_spec formula
            indices.1 indices.2 precision .infimum
          have hchild := hformula
            (Fin.cons
              (initial.limitRowPoint
                (initial.limitRowWitness formula indices.1 indices.2
                  precision .infimum))
              (fun i => initial.limitRowPoint (indices.1 i)))
            (fun i => initial.limitParameterPoint (indices.2 i))
          have hchild' :
              formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) =
                formula.toMultiFormula.realize M
                  (Fin.cons
                    (initial.limitRowMap
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitRowMap (indices.1 i)))
                  (fun i => initial.limitParameterMap (indices.2 i)) := by
            rw [hchild]
            congr 2
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          have hinf_le :
              (MultiFormula.iInfRow formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) ≤
                formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) := by
            change (⨅ x, formula.toMultiFormula.realize
              (initial.limitStructure) (Fin.cons x _) _) ≤ _
            exact iInf_le
              (fun x : (initial.limitStructure).Row =>
                formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons x
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)))
              (initial.limitRowPoint
                (initial.limitRowWitness formula indices.1 indices.2
                  precision .infimum))
          have hinf_le_real :=
            (Subtype.coe_le_coe.mpr hinf_le :
              ((MultiFormula.iInfRow formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) ≤
                (formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ))
          have hprecision' : witnessError precision < ε := by
            simpa [witnessError] using hprecision
          exact (calc
            ((MultiFormula.iInfRow formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) ≤
                (formula.toMultiFormula.realize (initial.limitStructure)
                  (Fin.cons
                    (initial.limitRowPoint
                      (initial.limitRowWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitRowPoint (indices.1 i)))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) :=
              hinf_le_real
            _ = (formula.toMultiFormula.realize M
                    (Fin.cons
                      (initial.limitRowMap
                        (initial.limitRowWitness formula indices.1 indices.2
                          precision .infimum))
                      (fun i => initial.limitRowMap (indices.1 i)))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) :=
              congrArg (fun value : TruthValue => (value : ℝ)) hchild'
            _ < ((MultiFormula.iInfRow formula.toMultiFormula).realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) +
                  witnessError precision := hspec
            _ < ((MultiFormula.iInfRow formula.toMultiFormula).realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) + ε :=
              by simpa [add_comm] using
                add_lt_add_left hprecision'
                  ((MultiFormula.iInfRow formula.toMultiFormula).realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ)).le
        · refine le_iInf fun x => ?_
          rw [hformula]
          have hcons :
              (fun i => initial.limitRowInclusion
                (@Fin.cons rowVars
                  (fun _ : Fin (rowVars + 1) => (initial.limitStructure).Row)
                  x (initial.limitAssignmentPoint indices).1 i)) =
                Fin.cons (initial.limitRowInclusion x)
                  (fun i => initial.limitRowMap (indices.1 i)) := by
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          rw [hcons]
          change (⨅ z : M.Row, formula.toMultiFormula.realize M
            (Fin.cons z _) _) ≤ _
          simpa [limitAssignmentPoint, includeLimitAssignment] using iInf_le
            (fun z : M.Row => formula.toMultiFormula.realize M
              (Fin.cons z
                (fun i => initial.limitRowMap (indices.1 i)))
              (fun i => initial.limitParameterMap (indices.2 i)))
            (initial.limitRowInclusion x))
  exact congrFun hequal (rows, parameters)

/-- A rational parameter supremum is preserved by the closed witness-limit
restriction once its child formula is preserved. -/
theorem realize_iSupParameter_limitStructure_eq_ambient [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ}
    (formula : CountableFormula Symbol rowVars (parameterVars + 1))
    (hformula : ∀
      (rows : Fin rowVars → (initial.limitStructure).Row)
      (parameters : Fin (parameterVars + 1) →
        (initial.limitStructure).Parameter),
      formula.toMultiFormula.realize (initial.limitStructure) rows parameters =
        formula.toMultiFormula.realize M
          (fun i => initial.limitRowInclusion (rows i))
          (fun i => initial.limitParameterInclusion (parameters i)))
    (rows : Fin rowVars → (initial.limitStructure).Row)
    (parameters : Fin parameterVars → (initial.limitStructure).Parameter) :
    (MultiFormula.iSupParameter formula.toMultiFormula).realize
        (initial.limitStructure) rows parameters =
      (MultiFormula.iSupParameter formula.toMultiFormula).realize M
        (fun i => initial.limitRowInclusion (rows i))
        (fun i => initial.limitParameterInclusion (parameters i)) := by
  let restricted :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    (MultiFormula.iSupParameter formula.toMultiFormula).assignmentValue
      (initial.limitStructure)
  let ambient :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    fun assignment =>
      (MultiFormula.iSupParameter formula.toMultiFormula).assignmentValue M
        (initial.includeLimitAssignment assignment)
  have hrestricted : Continuous restricted :=
    (MultiFormula.iSupParameter formula.toMultiFormula).continuous_assignmentValue
      (initial.limitStructure)
  have hambient : Continuous ambient :=
    ((MultiFormula.iSupParameter formula.toMultiFormula).continuous_assignmentValue M).comp
      (initial.continuous_includeLimitAssignment rowVars parameterVars)
  have hequal : restricted = ambient :=
    (initial.denseRange_limitAssignmentPoint rowVars parameterVars).equalizer
      hrestricted hambient (by
        funext indices
        apply le_antisymm
        · refine iSup_le fun y => ?_
          rw [hformula]
          have hcons :
              (fun i => initial.limitParameterInclusion
                (@Fin.cons parameterVars
                  (fun _ : Fin (parameterVars + 1) =>
                    (initial.limitStructure).Parameter)
                  y (initial.limitAssignmentPoint indices).2 i)) =
                Fin.cons (initial.limitParameterInclusion y)
                  (fun i => initial.limitParameterMap (indices.2 i)) := by
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          rw [hcons]
          change _ ≤ ⨆ z : M.Parameter, formula.toMultiFormula.realize M
            _ (Fin.cons z _)
          simpa [limitAssignmentPoint, includeLimitAssignment] using le_iSup
            (fun z : M.Parameter => formula.toMultiFormula.realize M
              (fun i => initial.limitRowMap (indices.1 i))
              (Fin.cons z
                (fun i => initial.limitParameterMap (indices.2 i))))
            (initial.limitParameterInclusion y)
        · rw [← Subtype.coe_le_coe]
          apply le_of_forall_pos_le_add
          intro ε hε
          obtain ⟨precision, hprecision⟩ := exists_nat_one_div_lt hε
          have hspec := initial.limitParameterWitness_spec formula
            indices.1 indices.2 precision .supremum
          have hchild := hformula
            (fun i => initial.limitRowPoint (indices.1 i))
            (Fin.cons
              (initial.limitParameterPoint
                (initial.limitParameterWitness formula indices.1 indices.2
                  precision .supremum))
              (fun i => initial.limitParameterPoint (indices.2 i)))
          have hchild' :
              formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) =
                formula.toMultiFormula.realize M
                  (fun i => initial.limitRowMap (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterMap
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitParameterMap (indices.2 i))) := by
            rw [hchild]
            congr 2
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          have hwitness_le :
              formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) ≤
                (MultiFormula.iSupParameter formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) := by
            change _ ≤ ⨆ y, formula.toMultiFormula.realize
              (initial.limitStructure) _ (Fin.cons y _)
            exact le_iSup
              (fun y : (initial.limitStructure).Parameter =>
                formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons y
                    (fun i => initial.limitParameterPoint (indices.2 i))))
              (initial.limitParameterPoint
                (initial.limitParameterWitness formula indices.1 indices.2
                  precision .supremum))
          have hwitness_le_real :=
            (Subtype.coe_le_coe.mpr hwitness_le :
              (formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .supremum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) : ℝ) ≤
                ((MultiFormula.iSupParameter formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ))
          have hprecision' : witnessError precision < ε := by
            simpa [witnessError] using hprecision
          exact (calc
            ((MultiFormula.iSupParameter formula.toMultiFormula).realize M
                (fun i => initial.limitRowMap (indices.1 i))
                (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) <
                (formula.toMultiFormula.realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (Fin.cons
                      (initial.limitParameterMap
                        (initial.limitParameterWitness formula indices.1 indices.2
                          precision .supremum))
                      (fun i => initial.limitParameterMap (indices.2 i))) : ℝ) +
                  witnessError precision := hspec
            _ = (formula.toMultiFormula.realize (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (Fin.cons
                      (initial.limitParameterPoint
                        (initial.limitParameterWitness formula indices.1 indices.2
                          precision .supremum))
                      (fun i => initial.limitParameterPoint (indices.2 i))) : ℝ) +
                  witnessError precision :=
              congrArg (fun value : TruthValue => (value : ℝ) +
                witnessError precision) hchild'.symm
            _ ≤ ((MultiFormula.iSupParameter formula.toMultiFormula).realize
                    (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) +
                  witnessError precision := by
              simpa [add_comm] using
                add_le_add_right hwitness_le_real (witnessError precision)
            _ < ((MultiFormula.iSupParameter formula.toMultiFormula).realize
                    (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) + ε :=
              by simpa [add_comm] using
                add_lt_add_left hprecision'
                  ((MultiFormula.iSupParameter formula.toMultiFormula).realize
                    (initial.limitStructure)
                    (fun i => initial.limitRowPoint (indices.1 i))
                    (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ)).le)
  exact congrFun hequal (rows, parameters)

/-- A rational parameter infimum is preserved by the closed witness-limit
restriction once its child formula is preserved. -/
theorem realize_iInfParameter_limitStructure_eq_ambient [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ}
    (formula : CountableFormula Symbol rowVars (parameterVars + 1))
    (hformula : ∀
      (rows : Fin rowVars → (initial.limitStructure).Row)
      (parameters : Fin (parameterVars + 1) →
        (initial.limitStructure).Parameter),
      formula.toMultiFormula.realize (initial.limitStructure) rows parameters =
        formula.toMultiFormula.realize M
          (fun i => initial.limitRowInclusion (rows i))
          (fun i => initial.limitParameterInclusion (parameters i)))
    (rows : Fin rowVars → (initial.limitStructure).Row)
    (parameters : Fin parameterVars → (initial.limitStructure).Parameter) :
    (MultiFormula.iInfParameter formula.toMultiFormula).realize
        (initial.limitStructure) rows parameters =
      (MultiFormula.iInfParameter formula.toMultiFormula).realize M
        (fun i => initial.limitRowInclusion (rows i))
        (fun i => initial.limitParameterInclusion (parameters i)) := by
  let restricted :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    (MultiFormula.iInfParameter formula.toMultiFormula).assignmentValue
      (initial.limitStructure)
  let ambient :
      MultiFormula.Assignment (initial.limitStructure) rowVars parameterVars →
        TruthValue :=
    fun assignment =>
      (MultiFormula.iInfParameter formula.toMultiFormula).assignmentValue M
        (initial.includeLimitAssignment assignment)
  have hrestricted : Continuous restricted :=
    (MultiFormula.iInfParameter formula.toMultiFormula).continuous_assignmentValue
      (initial.limitStructure)
  have hambient : Continuous ambient :=
    ((MultiFormula.iInfParameter formula.toMultiFormula).continuous_assignmentValue M).comp
      (initial.continuous_includeLimitAssignment rowVars parameterVars)
  have hequal : restricted = ambient :=
    (initial.denseRange_limitAssignmentPoint rowVars parameterVars).equalizer
      hrestricted hambient (by
        funext indices
        apply le_antisymm
        · rw [← Subtype.coe_le_coe]
          apply le_of_forall_pos_le_add
          intro ε hε
          obtain ⟨precision, hprecision⟩ := exists_nat_one_div_lt hε
          have hspec := initial.limitParameterWitness_spec formula
            indices.1 indices.2 precision .infimum
          have hchild := hformula
            (fun i => initial.limitRowPoint (indices.1 i))
            (Fin.cons
              (initial.limitParameterPoint
                (initial.limitParameterWitness formula indices.1 indices.2
                  precision .infimum))
              (fun i => initial.limitParameterPoint (indices.2 i)))
          have hchild' :
              formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) =
                formula.toMultiFormula.realize M
                  (fun i => initial.limitRowMap (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterMap
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitParameterMap (indices.2 i))) := by
            rw [hchild]
            congr 2
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          have hinf_le :
              (MultiFormula.iInfParameter formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) ≤
                formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) := by
            change (⨅ y, formula.toMultiFormula.realize
              (initial.limitStructure) _ (Fin.cons y _)) ≤ _
            exact iInf_le
              (fun y : (initial.limitStructure).Parameter =>
                formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons y
                    (fun i => initial.limitParameterPoint (indices.2 i))))
              (initial.limitParameterPoint
                (initial.limitParameterWitness formula indices.1 indices.2
                  precision .infimum))
          have hinf_le_real :=
            (Subtype.coe_le_coe.mpr hinf_le :
              ((MultiFormula.iInfParameter formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) ≤
                (formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) : ℝ))
          have hprecision' : witnessError precision < ε := by
            simpa [witnessError] using hprecision
          exact (calc
            ((MultiFormula.iInfParameter formula.toMultiFormula).realize
                  (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (fun i => initial.limitParameterPoint (indices.2 i)) : ℝ) ≤
                (formula.toMultiFormula.realize (initial.limitStructure)
                  (fun i => initial.limitRowPoint (indices.1 i))
                  (Fin.cons
                    (initial.limitParameterPoint
                      (initial.limitParameterWitness formula indices.1 indices.2
                        precision .infimum))
                    (fun i => initial.limitParameterPoint (indices.2 i))) : ℝ) :=
              hinf_le_real
            _ = (formula.toMultiFormula.realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (Fin.cons
                      (initial.limitParameterMap
                        (initial.limitParameterWitness formula indices.1 indices.2
                          precision .infimum))
                      (fun i => initial.limitParameterMap (indices.2 i))) : ℝ) :=
              congrArg (fun value : TruthValue => (value : ℝ)) hchild'
            _ < ((MultiFormula.iInfParameter formula.toMultiFormula).realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) +
                  witnessError precision := hspec
            _ < ((MultiFormula.iInfParameter formula.toMultiFormula).realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ) + ε :=
              by simpa [add_comm] using
                add_lt_add_left hprecision'
                  ((MultiFormula.iInfParameter formula.toMultiFormula).realize M
                    (fun i => initial.limitRowMap (indices.1 i))
                    (fun i => initial.limitParameterMap (indices.2 i)) : ℝ)).le
        · refine le_iInf fun y => ?_
          rw [hformula]
          have hcons :
              (fun i => initial.limitParameterInclusion
                (@Fin.cons parameterVars
                  (fun _ : Fin (parameterVars + 1) =>
                    (initial.limitStructure).Parameter)
                  y (initial.limitAssignmentPoint indices).2 i)) =
                Fin.cons (initial.limitParameterInclusion y)
                  (fun i => initial.limitParameterMap (indices.2 i)) := by
            funext i
            refine Fin.cases ?_ (fun j => ?_) i
            · rfl
            · rfl
          rw [hcons]
          change (⨅ z : M.Parameter, formula.toMultiFormula.realize M
            _ (Fin.cons z _)) ≤ _
          simpa [limitAssignmentPoint, includeLimitAssignment] using iInf_le
            (fun z : M.Parameter => formula.toMultiFormula.realize M
              (fun i => initial.limitRowMap (indices.1 i))
              (Fin.cons z
                (fun i => initial.limitParameterMap (indices.2 i))))
            (initial.limitParameterInclusion y))
  exact congrFun hequal (rows, parameters)

/-- Every well-formed rational formula is preserved by inclusion of the
closed witness-limit structure into its ambient structure. -/
theorem rationalFormula_realize_limitStructure_eq_ambient [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    (formula : RationalFormula Symbol) :
    ∀ {rowVars parameterVars : ℕ}
      (hformula : formula.WellFormed rowVars parameterVars)
      (rows : Fin rowVars → (initial.limitStructure).Row)
      (parameters : Fin parameterVars → (initial.limitStructure).Parameter),
      (formula.toMultiFormula rowVars parameterVars hformula).realize
          (initial.limitStructure) rows parameters =
        (formula.toMultiFormula rowVars parameterVars hformula).realize M
          (fun i => initial.limitRowInclusion (rows i))
          (fun i => initial.limitParameterInclusion (parameters i)) := by
  induction formula with
  | predicate symbol row parameter =>
      intro rowVars parameterVars hformula rows parameters
      rfl
  | constant value =>
      intro rowVars parameterVars hformula rows parameters
      rfl
  | affine₂ bias firstCoefficient secondCoefficient left right
      leftInduction rightInduction =>
      intro rowVars parameterVars hformula rows parameters
      simp only [RationalFormula.WellFormed] at hformula
      simp only [RationalFormula.toMultiFormula, MultiFormula.realize]
      apply congrArg (rationalClippedAffine₂ bias firstCoefficient secondCoefficient)
      funext coordinate
      refine Fin.cases ?_ (fun remaining => ?_) coordinate
      · exact leftInduction hformula.1 rows parameters
      · exact Fin.cases (rightInduction hformula.2 rows parameters)
          (fun impossible => Fin.elim0 impossible) remaining
  | min left right leftInduction rightInduction =>
      intro rowVars parameterVars hformula rows parameters
      simp only [RationalFormula.WellFormed] at hformula
      simp only [RationalFormula.toMultiFormula, MultiFormula.realize]
      apply congrArg rationalMinConnective
      funext coordinate
      refine Fin.cases ?_ (fun remaining => ?_) coordinate
      · exact leftInduction hformula.1 rows parameters
      · exact Fin.cases (rightInduction hformula.2 rows parameters)
          (fun impossible => Fin.elim0 impossible) remaining
  | max left right leftInduction rightInduction =>
      intro rowVars parameterVars hformula rows parameters
      simp only [RationalFormula.WellFormed] at hformula
      simp only [RationalFormula.toMultiFormula, MultiFormula.realize]
      apply congrArg rationalMaxConnective
      funext coordinate
      refine Fin.cases ?_ (fun remaining => ?_) coordinate
      · exact leftInduction hformula.1 rows parameters
      · exact Fin.cases (rightInduction hformula.2 rows parameters)
          (fun impossible => Fin.elim0 impossible) remaining
  | iSupRow child induction =>
      intro rowVars parameterVars hformula rows parameters
      let childFormula : CountableFormula Symbol (rowVars + 1) parameterVars :=
        ⟨child, hformula⟩
      simpa only [RationalFormula.toMultiFormula,
        CountableFormula.toMultiFormula] using
        initial.realize_iSupRow_limitStructure_eq_ambient childFormula
          (fun childRows childParameters =>
            induction hformula childRows childParameters)
          rows parameters
  | iInfRow child induction =>
      intro rowVars parameterVars hformula rows parameters
      let childFormula : CountableFormula Symbol (rowVars + 1) parameterVars :=
        ⟨child, hformula⟩
      simpa only [RationalFormula.toMultiFormula,
        CountableFormula.toMultiFormula] using
        initial.realize_iInfRow_limitStructure_eq_ambient childFormula
          (fun childRows childParameters =>
            induction hformula childRows childParameters)
          rows parameters
  | iSupParameter child induction =>
      intro rowVars parameterVars hformula rows parameters
      let childFormula : CountableFormula Symbol rowVars (parameterVars + 1) :=
        ⟨child, hformula⟩
      simpa only [RationalFormula.toMultiFormula,
        CountableFormula.toMultiFormula] using
        initial.realize_iSupParameter_limitStructure_eq_ambient childFormula
          (fun childRows childParameters =>
            induction hformula childRows childParameters)
          rows parameters
  | iInfParameter child induction =>
      intro rowVars parameterVars hformula rows parameters
      let childFormula : CountableFormula Symbol rowVars (parameterVars + 1) :=
        ⟨child, hformula⟩
      simpa only [RationalFormula.toMultiFormula,
        CountableFormula.toMultiFormula] using
        initial.realize_iInfParameter_limitStructure_eq_ambient childFormula
          (fun childRows childParameters =>
            induction hformula childRows childParameters)
          rows parameters

/-- Every formula in the fixed-variable countable fragment is preserved by
the closed witness-limit restriction. -/
theorem CountableFormula.realize_limitStructure_eq_ambient [Encodable Symbol]
    (initial : WitnessIndexing M)
    [Nonempty initial.RowIndex] [Nonempty initial.ParameterIndex]
    {rowVars parameterVars : ℕ}
    (formula : CountableFormula Symbol rowVars parameterVars)
    (rows : Fin rowVars → (initial.limitStructure).Row)
    (parameters : Fin parameterVars → (initial.limitStructure).Parameter) :
    formula.toMultiFormula.realize (initial.limitStructure) rows parameters =
      formula.toMultiFormula.realize M
        (fun i => initial.limitRowInclusion (rows i))
        (fun i => initial.limitParameterInclusion (parameters i)) :=
  initial.rationalFormula_realize_limitStructure_eq_ambient
    formula.1 formula.2 rows parameters

end WitnessIndexing

